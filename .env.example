# --- LLM (OpenRouter, OpenAI-compatible API) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# ":free" models rotate over time - check https://openrouter.ai/models?max_price=0
# and prefer ones that support structured outputs.
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
# Optional, comma-separated. OpenRouter tries these in order if the primary model
# is down or rate-limited upstream (max 3 models total, primary included).
# Avoid slow models: a reply that takes over 45s is abandoned.
OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free

# --- PRISM (Block Convey) zero-code tracing proxy ---
# Leave PRISM_ENABLED=false to call OpenRouter directly (e.g. while PRISM isn't set up yet).
# Flip to true once you have real proxy details from Block Convey / the hackathon organizers.
PRISM_ENABLED=false
PRISM_API_KEY=your_prism_api_key_here
PRISM_PROJECT_ID=your_prism_project_id_here
PRISM_PROXY_URL=https://proxy.blockconvey.example

# --- Persistence (Redis) ---
# Leave blank for local dev - store.py falls back to an in-memory dict.
# Required on Vercel: add the "Redis" marketplace integration to the
# project and it auto-fills this.
REDIS_URL=
