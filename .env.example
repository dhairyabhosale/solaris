# --- LLM (Groq, OpenAI-compatible API) ---
GROQ_API_KEY=your_groq_api_key_here
# llama-3.3-70b-versatile is deprecated on Groq's free tier (shut down
# 2026-08-16) - gpt-oss-120b is Groq's recommended replacement and supports
# strict structured outputs, which the app relies on for a parseable reply.
# Check https://console.groq.com/docs/rate-limits before changing this.
GROQ_MODEL=openai/gpt-oss-120b

# --- PRISM (Block Convey) zero-code tracing proxy ---
# Leave PRISM_ENABLED=false to call Groq directly (e.g. while PRISM isn't set up yet).
# Flip to true once you have real proxy details from Block Convey / the hackathon organizers.
PRISM_ENABLED=false
PRISM_API_KEY=your_prism_api_key_here
PRISM_PROJECT_ID=your_prism_project_id_here
PRISM_PROXY_URL=https://proxy.blockconvey.example

# --- Persistence (Redis) ---
# Leave blank for local dev - store.py falls back to an in-memory dict.
# Required on Vercel: add the "Redis" marketplace integration to the
# project and it auto-fills this.
REDIS_URL=
