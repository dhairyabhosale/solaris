# --- LLM (Groq, OpenAI-compatible API) ---
GROQ_API_KEY=your_groq_api_key_here
# llama-3.3-70b-versatile is deprecated on Groq's free tier (shut down
# 2026-08-16) - gpt-oss-120b is Groq's recommended replacement and supports
# strict structured outputs, which the app relies on for a parseable reply.
# Check https://console.groq.com/docs/rate-limits before changing this.
GROQ_MODEL=openai/gpt-oss-120b

# --- PRISM (Block Convey) live tracing ---
# Get these from prism.blockconvey.com/onboarding. Leave PRISMTRACE_API_KEY
# blank to disable tracing entirely - the app works the same either way,
# this is a side-channel trace POST after each model call, not something
# the chat response depends on.
PRISMTRACE_API_KEY=your_prismtrace_api_key_here
PRISMTRACE_PROJECT_ID=your_prismtrace_project_id_here
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app

# --- Persistence (Redis) ---
# Leave blank for local dev - store.py falls back to an in-memory dict.
# Required on Vercel: add the "Redis" marketplace integration to the
# project and it auto-fills this.
REDIS_URL=
